# Namma Seva AI backend configuration (names only; never commit real values)

# Provider selection. Phase 1 default is the offline MockProvider.
NSA_PROVIDER=mock

# Allowed CORS origins (comma-separated). Defaults to the local Vite dev server.
# In production, set this to the deployed frontend origin(s) — do not use "*".
# This is the Amplify-hosted FRONTEND URL (not the backend URL).
# Example (local dev + the deployed Amplify frontend together):
#   NSA_ALLOWED_ORIGINS=http://localhost:5173,https://staging.d2jovlq11yujgp.amplifyapp.com
NSA_ALLOWED_ORIGINS=http://localhost:5173

# Bedrock is NOT required in Phase 1. These are placeholders for later.
# AWS_REGION=
# NSA_BEDROCK_MODEL_ID=

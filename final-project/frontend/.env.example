# Namma Seva AI frontend configuration (names only; never commit real values).
#
# Copy to `.env.local` for local overrides, or set these as environment
# variables in your host (e.g. AWS Amplify build settings). `.env` / `*.local`
# files are gitignored.

# Base URL of the FastAPI backend API.
#
# Local development: leave this UNSET. The app defaults to "/api" and the Vite
# dev server proxies /api -> http://localhost:8000 (see vite.config.ts).
#
# Production (e.g. AWS Amplify): set this to your deployed backend origin, for
# example:
#   VITE_API_BASE_URL=https://your-backend-host.example.com
#
# VITE_API_BASE_URL=
